DB_NAME=xianyusmart
DB_USERNAME=xianyusmart
DB_PASSWORD=change-me-database-password
DB_ROOT_PASSWORD=change-me-root-password
MYSQL_DATA_VOLUME=xianyu-plus-mysql-data
APP_DATA_VOLUME=xianyu-plus-app-data
APP_LOGS_VOLUME=xianyu-plus-app-logs
APP_NETWORK_NAME=xianyu-plus
APP_IMAGE=xianyu-plus:latest
JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_EXPIRATION_MS=28800000
ALLOWED_ORIGINS=http://localhost:12400
TRUST_PROXY=false
UPDATE_RELEASE_API=
UPDATE_GITHUB_REPOSITORY=najiuwanan511/xianyu-Plus
UPDATE_HOST_DIR=./runtime/update
UPDATE_CHECK_CACHE_MINUTES=60
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
JAVA_OPTS=-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=20 -XX:+ExitOnOutOfMemoryError
TZ=Asia/Shanghai
CAPTCHA_BROWSER_ENABLED=true
# 桌面部署人工滑块设为 false；无显示器服务器保持 true 并使用手动 Cookie 更新兜底。
CAPTCHA_BROWSER_HEADLESS=true
CAPTCHA_BROWSER_TIMEOUT_SECONDS=120
CAPTCHA_BROWSER_MAX_CONCURRENT=1
# 飞牛 OS 远程滑块：启用后打开 http://飞牛IP:7900/vnc.html?autoconnect=true&resize=scale
# 密码最多使用前 8 位；请务必修改默认值，并在启用远程模式时将 headless 交给远程 Xvfb 管理。
CAPTCHA_BROWSER_REMOTE_ENABLED=false
CAPTCHA_BROWSER_REMOTE_PORT=7900
CAPTCHA_BROWSER_REMOTE_BIND=0.0.0.0
CAPTCHA_BROWSER_REMOTE_URL=
CAPTCHA_BROWSER_VNC_PASSWORD=change-me
RED_FLOWER_INTERVAL_MS=300000
RED_FLOWER_INITIAL_DELAY_MS=90000
RED_FLOWER_LOOKBACK_DAYS=30
RED_FLOWER_BATCH_SIZE=50
